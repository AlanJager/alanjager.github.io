#!/bin/sh
export PATH=/bin:/sbin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /sys/kernel/tracing
mount -t tracefs tracefs /sys/kernel/tracing
echo LAB_GUEST_BOOT
uname -a
sleep 3
for d in /sys/bus/pci/devices/*; do
    if [ "$(cat "$d/vendor")" = 0x8086 ] && [ "$(cat "$d/device")" = 0x0d93 ]; then
        bdf=${d##*/}
        echo "CXL_DEVICE $bdf"
        echo cxl_compression > "$d/driver_override"
        if [ -L "$d/driver" ]; then echo "$bdf" > "$d/driver/unbind"; fi
        echo "$bdf" > /sys/bus/pci/drivers/cxl_compression/bind
    fi
done
sleep 3
echo NODE_PRIVATE
cat /sys/devices/system/node/has_private_memory
echo NODE_ONLINE
cat /sys/devices/system/node/online
cat /sys/devices/system/node/node*/meminfo
nid=$(cat /sys/devices/system/node/has_private_memory)
echo false > /sys/kernel/mm/numa/demotion_enabled
echo lz4 > /sys/block/zram0/comp_algorithm
echo 64M > /sys/block/zram0/disksize
mkswap /dev/zram0
swapon /dev/zram0
echo TRACING_DISABLED
echo 0 > /sys/kernel/tracing/tracing_on
echo nop > /sys/kernel/tracing/current_tracer
echo 0 > /sys/kernel/tracing/events/enable
cat /sys/kernel/tracing/current_tracer
cat /sys/kernel/tracing/tracing_on
for backend in dram cram zram; do
 for mode in direct readwrite readrepeat; do
  /bin/bench "$backend" "$mode" "$nid"
  echo "BENCH_EXIT ${backend}_${mode} $?"
 done
done
swapoff /dev/zram0
echo 1 > /sys/block/zram0/reset
echo LAB_GUEST_DONE
poweroff -f
