<%
var tags = page.tags ? page.tags.data : '';
var site = (config.url || 'https://hanayo.cn').replace(/\/$/, '').replace(/^http:/i, 'https:');
var canonical = (page.permalink || (site + '/' + (page.path || ''))).replace(/^http:/i, 'https:');
var desc = page.description || config.description || '';
%>

<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
  <meta name="viewport"
        content="width=device-width, initial-scale=1.0, user-scalable=no">
  <title>
    <%= (page.title || config.title) + (page.title ? ' | ' + config.title : '') %>
  </title>
  <meta name="description" content="<%= desc %>">
  <%
  if(tags){ %>
  <meta name="keywords" content="
  <%= tags.map(function(tag) {
    return tag.name
  }).join(',') %>
  ">
  <% } %>
  <meta name="author" content="<%= config.author %>">
  <link rel="canonical" href="<%= canonical %>">
  <link rel="sitemap" type="application/xml" href="<%= config.root %>sitemap.xml">
  <meta property="og:type" content="<%= page.layout === 'post' ? 'article' : 'website' %>">
  <meta property="og:title" content="<%= page.title || config.title %>">
  <meta property="og:url" content="<%= canonical %>">
  <meta property="og:site_name" content="<%= config.title %>">
  <meta property="og:description" content="<%= desc %>">
  <% if (page.layout === 'post' && page.date) { %>
  <meta property="article:published_time" content="<%= page.date.toISOString() %>">
  <meta property="article:modified_time" content="<%= (page.updated || page.date).toISOString() %>">
  <% } %>

  <meta http-equiv="Cache-Control" content="no-transform"/>
  <meta http-equiv="Cache-Control" content="no-siteapp">

  <link rel="icon" type="image/x-icon" href="<%= config.favicon %>">
  <link rel="stylesheet" href="<%= config.root %>css/main.css">
  <link rel="stylesheet"
        href="https://maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
  <%- partial('_widget/google-analytics') %>
  <%- partial('_widget/baidutongji') %>
  <%- partial('_partial/jsonld') %>
  <script src="//cdnjs.cloudflare.com/ajax/libs/vue/1.0.25-csp/vue.min.js"></script>
  <script src="//cdnjs.cloudflare.com/ajax/libs/moment.js/2.11.2/moment.min.js"></script>
</head>
